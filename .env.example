# Environment Example
# Copy to .env and fill in your values

# Application
APP_NAME=beacon-pilot-alan-vo
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/beacon.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC / Keycloak
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/beacon-pilot
OIDC_CLIENT_ID=beacon-pilot-frontend
OIDC_CLIENT_SECRET=dev-secret-change-in-production
OIDC_REDIRECT_URI=http://127.0.0.1:5173/callback
OIDC_AUDIENCE=beacon-pilot-frontend

# LLM Providers
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]